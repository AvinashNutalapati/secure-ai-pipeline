{
  "name": "secure-ai-pipeline",
  "displayName": "Secure AI Pipeline",
  "description": "Security for AI-assisted development — inline diagnostics for insecure code plus an AI Agent Blast Radius checkup for MCP, Claude/Cursor configs, and GitHub Actions.",
  "version": "2.0.1",
  "publisher": "AvinashNutalapati1",
  "license": "MIT",
  "homepage": "https://mirawyn.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/AvinashNutalapati/secure-ai-pipeline.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "security",
    "ai",
    "sast",
    "cursor",
    "mcp",
    "claude",
    "slopsquatting"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:yaml",
    "onLanguage:markdown",
    "onLanguage:plaintext",
    "workspaceContains:**/mcp.json",
    "workspaceContains:**/.claude/settings.json",
    "workspaceContains:**/.cursorrules",
    "workspaceContains:**/.github/workflows/*.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "securePipeline",
          "title": "Secure AI Pipeline",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "securePipeline": [
        {
          "id": "securePipeline.findings",
          "name": "Findings"
        }
      ]
    },
    "commands": [
      {
        "command": "securePipeline.showProblems",
        "title": "Secure AI Pipeline: Show Problems"
      },
      {
        "command": "securePipeline.scanWorkspace",
        "title": "Secure AI Pipeline: Rescan Open Files"
      },
      {
        "command": "securePipeline.blastRadius",
        "title": "Secure AI Pipeline: AI Blast Radius Scan"
      }
    ],
    "configuration": {
      "title": "Secure AI Pipeline",
      "properties": {
        "securePipeline.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Secure AI Pipeline extension."
        },
        "securePipeline.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ],
          "default": "warning",
          "description": "Minimum severity to display. 'error' hides warning-level findings."
        },
        "securePipeline.runOnType": {
          "type": "boolean",
          "default": false,
          "description": "Run checks while typing, not just on save."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
